{"version":3,"term":{"cols":80,"rows":24,"type":"xterm-256color"},"timestamp":1776333124,"idle_time_limit":5.0,"command":"./demo-kata-shim-t.sh","title":"kata_shim_t: dedicated SELinux domain for Kata Containers","env":{"SHELL":"/bin/zsh"}}
[0.256, "o", "\r\n\u001b[1;36m# kata_shim_t: dedicated SELinux domain for the Kata Containers shim\u001b[0m\r\n"]
[2.007, "o", "\r\n\u001b[1;36m# This confines the shim to least-privilege, preventing lateral movement between pods.\u001b[0m\r\n"]
[3.019, "o", "\r\n\u001b[1;36m# Step 1: Verify the SELinux policy is loaded and the shim is labeled\u001b[0m\r\n"]
[2.011, "o", "\r\n\u001b[1;32m$ oc debug node/kata-420-cluster-c7s7n-worker-eastus2-5pwwc --quiet -- chroot /host semodule -l 2>/dev/null | grep kata_shim\u001b[0m\r\n"]
[3.057, "o", "kata_shim_v2\r\n"]
[2.182, "o", "\r\n\u001b[1;32m$ oc debug node/kata-420-cluster-c7s7n-worker-eastus2-5pwwc --quiet -- chroot /host ls -Z /usr/bin/containerd-shim-kata-v2\u001b[0m\r\n"]
[2.754, "o", "system_u:object_r:kata_shim_exec_t:s0 /usr/bin/containerd-shim-kata-v2\r\n"]
[2.159, "o", "\r\n\u001b[1;36m# The shim binary has the kata_shim_exec_t label.\u001b[0m\r\n"]
[2.008, "o", "\r\n\u001b[1;36m# When CRI-O (container_runtime_t) executes it, the process transitions to kata_shim_t.\u001b[0m\r\n"]
[2.010, "o", "\r\n\u001b[1;36m# Step 2: Verify kata_shim_t is in enforcing mode (NOT permissive)\u001b[0m\r\n"]
[2.013, "o", "\r\n\u001b[1;32m$ oc debug node/kata-420-cluster-c7s7n-worker-eastus2-5pwwc --quiet -- chroot /host sh -c 'semanage permissive -l 2>/dev/null | grep kata || echo \"kata_shim_t is NOT permissive -- full enforcement\"'\u001b[0m\r\n"]
[2.870, "o", "kata_shim_t is NOT permissive -- full enforcement\r\n"]
[2.199, "o", "\r\n\u001b[1;36m# Step 3: Create a Kata pod\u001b[0m\r\n"]
[2.013, "o", "\r\n\u001b[1;32m$ cat <<'EOF' | oc apply -f -\r\n"]
[0.000, "o", "apiVersion: v1\r\nkind: Pod\r\nmetadata:\r\n  name: demo-kata-1\r\nspec:\r\n  runtimeClassName: kata\r\n  nodeName: kata-420-cluster-c7s7n-worker-eastus2-5pwwc\r\n  containers:\r\n"]
[0.000, "o", "  - name: test\r\n"]
[0.000, "o", "    image: registry.access.redhat.com/ubi9/ubi-minimal:latest\r\n"]
[0.000, "o", "    command: [\"sleep\", \"infinity\"]\r\n"]
[0.000, "o", "  terminationGracePeriodSeconds: 0\r\n"]
[0.000, "o", "EOF\u001b[0m\r\n"]
[1.488, "o", "pod/demo-kata-1 created\r\n"]
[2.011, "o", "\r\n\u001b[1;36m# Waiting for pod to start...\u001b[0m\r\n"]
[5.781, "o", "\r\n\u001b[1;32m$ oc get pod demo-kata-1 -o wide\u001b[0m\r\n"]
[1.391, "o", "NAME          READY   STATUS    RESTARTS   AGE   IP            NODE                                        "]
[0.000, "o", "  NOMINATED NODE   READINESS GATES\r\ndemo-kata-1   1/1     Running   "]
[0.000, "o", "0          "]
[0.000, "o", "9s"]
[0.000, "o", "    "]
[0.000, "o", "10.128.2.36"]
[0.000, "o", "   "]
[0.000, "o", "kata-420-cluster-c7s7n-worker-eastus2-5pwwc   <none>           <none>\r\n"]
[2.012, "o", "\r\n\u001b[1;36m# Step 4: Check that QEMU runs as container_kvm_t with MCS labels\u001b[0m\r\n"]
[2.013, "o", "\r\n\u001b[1;32m$ oc debug node/kata-420-cluster-c7s7n-worker-eastus2-5pwwc --quiet -- chroot /host ps -eZ 2>/dev/null | grep qemu-kvm | grep -v grep\u001b[0m\r\n"]
[3.412, "o", "system_u:system_r:container_kvm_t:s0:c39,c150 1140391 ? 00:00:03 qemu-kvm\r\n"]
[2.013, "o", "\r\n\u001b[1;36m# Each pod's QEMU gets unique MCS categories (cX,cY) for isolation.\u001b[0m\r\n"]
[2.012, "o", "\r\n\u001b[1;36m# Step 5: Verify kubectl exec works through the confined shim\u001b[0m\r\n"]
[2.011, "o", "\r\n\u001b[1;32m$ oc exec demo-kata-1 -- uname -a\u001b[0m\r\n"]
[2.359, "o", "Linux demo-kata-1 5.14.0-570.92.1.el9_6.x86_64 #1 SMP PREEMPT_DYNAMIC Tue Feb 17 01:15:16 EST 2026 x86_64 x86_64 x86_64 GNU/Linux\r\n"]
[2.017, "o", "\r\n\u001b[1;32m$ oc exec demo-kata-1 -- cat /etc/os-release | head -3\u001b[0m\r\n"]
[2.368, "o", "NAME=\"Red Hat Enterprise Linux\"\r\nVERSION=\"9.7 (Plow)\"\r\nID=\"rhel\"\r\n"]
[2.018, "o", "\r\n\u001b[1;36m# Step 6: Create a second pod and verify MCS isolation\u001b[0m\r\n"]
[2.005, "o", "\r\n\u001b[1;32m$ cat <<'EOF' | oc apply -f -\r\napiVersion: v1\r\nkind: Pod\r\nmetadata:\r\n  name: demo-kata-2\r\nspec:\r\n"]
[0.000, "o", "  runtimeClassName: kata\r\n  nodeName: kata-420-cluster-c7s7n-worker-eastus2-5pwwc\r\n  containers:\r\n  - name: test\r\n    image: registry.access.redhat.com/ubi9/ubi-minimal:latest\r\n"]
[0.000, "o", "    command: [\"sleep\", \"infinity\"]\r\n"]
[0.000, "o", "  terminationGracePeriodSeconds: 0\r\nEOF\u001b[0m\r\n"]
[1.479, "o", "pod/demo-kata-2 created\r\n"]
[2.010, "o", "\r\n\u001b[1;36m# Waiting for second pod...\u001b[0m\r\n"]
[5.740, "o", "\r\n\u001b[1;32m$ oc get pods -o wide\u001b[0m\r\n"]
[1.373, "o", "NAME          READY   STATUS    RESTARTS   AGE   IP            NODE                                          NOMINATED NODE   READINESS GATES\r\ndemo-kata-1   "]
[0.000, "o", "1/1     Running   0          44s   10.128.2.36   kata-420-cluster-c7s7n-worker-eastus2-5pwwc   <none>"]
[0.000, "o", "        "]
[0.000, "o", "   <none>\r\n"]
[0.000, "o", "demo-kata-2"]
[0.000, "o", "   1/1"]
[0.000, "o", "     "]
[0.000, "o", "Running"]
[0.000, "o", "   "]
[0.000, "o", "0"]
[0.000, "o", "        "]
[0.000, "o", "  9s"]
[0.000, "o", "    "]
[0.000, "o", "10.128.2.37"]
[0.000, "o", "   "]
[0.000, "o", "kata-420-cluster-c7s7n-worker-eastus2-5pwwc"]
[0.000, "o", "   "]
[0.000, "o", "<none>"]
[0.000, "o", "        "]
[0.000, "o", "   <none>"]
[0.000, "o", "\r\n"]
[2.013, "o", "\r\n\u001b[1;36m# Both QEMU processes have different MCS labels:\u001b[0m\r\n"]
[2.015, "o", "\r\n\u001b[1;32m$ oc debug node/kata-420-cluster-c7s7n-worker-eastus2-5pwwc --quiet -- chroot /host ps -eZ 2>/dev/null | grep qemu-kvm | grep -v grep\u001b[0m\r\n"]
[2.663, "o", "system_u:system_r:container_kvm_t:s0:c39,c150 1140391 ? 00:00:04 qemu-kvm\r\nsystem_u:system_r:container_kvm_t:s0:c318,c955 1140744 ? 00:00:03 qemu-kvm\r\n"]
[2.005, "o", "\r\n\u001b[1;36m# Step 7: Check for AVC denials -- should be zero\u001b[0m\r\n"]
[2.008, "o", "\r\n"]
[0.000, "o", "\u001b[1;32m$ oc debug node/kata-420-cluster-c7s7n-worker-eastus2-5pwwc --quiet -- chroot /host sh -c 'ausearch -m AVC,USER_AVC -ts recent 2>/dev/null | grep kata_shim_t | grep permissive=0 | grep -v osc_monitor | wc -l | xargs echo \"enforcing denials:\"'\u001b[0m\r\n"]
[2.773, "o", "enforcing denials: 0\r\n"]
[2.159, "o", "\r\n\u001b[1;36m# Step 8: Clean up -- verify no orphan processes after deletion\u001b[0m\r\n"]
[2.004, "o", "\r\n\u001b[1;32m$ oc delete pod demo-kata-1 demo-kata-2 --grace-period=5\u001b[0m\r\n"]
[1.394, "o", "pod \"demo-kata-1\" deleted\r\n"]
[0.117, "o", "pod \"demo-kata-2\" deleted\r\n"]
[13.316, "o", "\r\n"]
[0.000, "o", "\u001b[1;32m$ oc debug node/kata-420-cluster-c7s7n-worker-eastus2-5pwwc --quiet -- chroot /host sh -c 'ps -eZ 2>/dev/null | grep -E \"containerd-shim-kata|qemu-kvm|virtiofsd\" | grep -v grep || echo \"CLEAN -- no orphan processes\"'\u001b[0m\r\n"]
[3.094, "o", "CLEAN -- no orphan processes\r\n"]
[2.155, "o", "\r\n\u001b[1;36m# Summary:\u001b[0m\r\n"]
[2.008, "o", "\r\n\u001b[1;36m# - Shim runs as kata_shim_t (not container_runtime_t)\u001b[0m\r\n"]
[2.012, "o", "\r\n\u001b[1;36m# - QEMU runs as container_kvm_t with per-pod MCS labels\u001b[0m\r\n"]
[2.011, "o", "\r\n\u001b[1;36m# - Zero AVC denials in enforcing mode\u001b[0m\r\n"]
[2.008, "o", "\r\n\u001b[1;36m# - Clean pod lifecycle (create, exec, delete)\u001b[0m\r\n"]
[2.005, "o", "\r\n\u001b[1;36m# - Three confinement layers: VM boundary + SELinux TE + MCS isolation\u001b[0m\r\n"]
[5.020, "x", "0"]
